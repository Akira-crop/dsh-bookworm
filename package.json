{
  "name": "dsh-bookworm",
  "version": "0.1.0",
  "description": "书蠹 Bookworm —— 微信读书的沉浸式阅读器，划词即可与 AI 多轮对话，并把书里的划线、笔记和阅读时长留在本地。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "weread",
    "wechat-reading",
    "reader",
    "reading",
    "ai",
    "微信读书",
    "阅读器",
    "读书笔记",
    "AI 陪读"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
